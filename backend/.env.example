# Server Configuration
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# Meta WhatsApp Cloud API Configuration
META_APP_SECRET=your_meta_app_secret_here
META_VERIFY_TOKEN=your_custom_webhook_verify_token_here
WHATSAPP_ACCESS_TOKEN=your_system_user_permanent_access_token_here
WHATSAPP_API_VERSION=v20.0

# Dedicated Phone Number IDs (Default per business)
WHATSAPP_PHONE_ID_EDU_ALT_TECH=WHATSAPP_PHONE_ID_EDU_ALT_TECH
WHATSAPP_PHONE_ID_SETSUZOKU=WHATSAPP_PHONE_ID_SETSUZOKU

# Supabase / PostgreSQL Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_bot

# AI Provider Configuration (OpenAI, Gemini, or Mock for tests)
AI_PROVIDER=mock # Options: "mock" (built-in offline testing), "openai", "gemini"
AI_PROVIDER_API_KEY=your_ai_provider_api_key_here
AI_MODEL=gpt-4o-mini

# Admin Authentication & Security
ADMIN_AUTH_SECRET=super_secret_jwt_key_min_32_characters_long_for_security
ADMIN_TOKEN_EXPIRY=24h
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info
